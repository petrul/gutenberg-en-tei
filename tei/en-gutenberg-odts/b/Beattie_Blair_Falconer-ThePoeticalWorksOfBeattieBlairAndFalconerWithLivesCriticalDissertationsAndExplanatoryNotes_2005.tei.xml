               <div type="div3">
                  <head>The Shipwreck: Canto I</head>
                  <p rend="justify">
                     <hi rend="bold">The Scene of which lies near the city of Candia.</hi>
                  </p>
                  <p rend="justify">
                     <hi rend="italic">Time: about four days and a half.</hi>
                  </p>
                  <p rend="justify">
                     <hi rend="bold italic">The Argument:</hi>
                  </p>
