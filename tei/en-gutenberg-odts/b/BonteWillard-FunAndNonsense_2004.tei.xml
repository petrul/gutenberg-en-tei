      <body>
         <head>Fun and Nonsense</head>
         <author>Willard Bonte</author>
         <author>Willard Bronte H.M. Caldwell Company New York and Boston</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/b/BonteWillard-FunAndNonsense_2004.odt</p>
         <head>Fun &amp; Nonsense</head>
         <author>
            <hi rend="bold">By Willard Bonte</hi>
         </author>
         <p>Frontispiece</p>
         <author>By Willard Bronte<lb/>H.M. Caldwell Company<lb/>New York and Boston</author>
         <p>Copyright 1904 by H.M. Caldwell</p>
         <pb/>
         <div type="div1">
            <head>Contents /x/</head>
            <p>INTRODUCTION</p>
            <table rend="frame" xml:id="Table1">
               <row>
                  <cell>
                     <p>THE BARBER</p>
                     <p>THE REFUSAL</p>
                     <p>A HOPELESS CASE</p>
                     <p>THE GREENHORN</p>
                     <p>OLD MR. MATCH</p>
