         <head>Little Bo-Peep: A Nursery Rhyme Picture Book</head>
         <author>L. Leslie Brooke</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/b/BrookeLLeslie-LittleBo-Peep_ANurseryRhymePictureBook_2007.odt</p>
         <p>image</p>
