            <p rend="justify">The Peter Pan<lb/>Alphabet</p>
            <p rend="justify"> </p>
            <p rend="justify">
               <hi rend="italic">By</hi>
               <lb/>Oliver Herford</p>
            <p rend="justify"> </p>
            <p rend="justify">image</p>
            <p rend="justify"> </p>
            <lg>
               <l>
                  <hi rend="italic">New York</hi>
               </l>
               <l>Charles Scribner’s Sons</l>
               <l>1907</l>
            </lg>
            <lg>
               <l>COPYRIGHT 1907</l>
               <l>BY OLIVER HERFORD</l>
               <l>PUBLISHED JANUARY 1907</l>
            </lg>
            <p rend="justify">
               <hi rend="italic">Contents</hi>
            </p>
            <table rend="frame" xml:id="Table2">
               <row>
                  <cell>A</cell>
