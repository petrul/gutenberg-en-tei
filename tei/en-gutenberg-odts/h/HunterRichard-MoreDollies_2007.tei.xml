         <p rend="start color(#000000)">en-gutenberg-odts/h/HunterRichard-MoreDollies_2007.odt</p>
         <head>MORE<lb/>DOLLIES</head>
         <pb/>
         <div type="div1">
            <head>More Dollies</head>
            <pb/>
            <div type="div2">
               <head>RUTH<lb/>COBB<lb/>AND<lb/>RICHARD<lb/>HUNTER</head>
               <div type="div3">
                  <head>THE DUMPY BOOKS<lb/>FOR CHILDREN</head>
               </div>
            </div>
            <pb/>
            <div type="div2">
               <head>
                  <label>25.</label>More Dollies<lb/>
               </head>
            </div>
            <pb/>
            <div type="div2">
               <head>
                  <hi rend="italic">The Dumpy Books for Children</hi>
               </head>
