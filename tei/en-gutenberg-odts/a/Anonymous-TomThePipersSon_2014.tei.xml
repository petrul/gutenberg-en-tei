            </div>
         </div>
         <pb/>
         <div type="div1">
            <head>TOM, THE PIPER'S SON</head>
            <pb/>
            <div type="div2">
               <head>By Anonymous</head>
               <div type="div3">
                  <head>Price One Half-Penny.<lb/>
                     <lb/>March, 12, Webber Street.</head>
                  <lg>
                     <l/>
                     <l/>
                     <l/>
                  </lg>
                  <p rend="justify">0003m <lb/>
                  </p>
                  <div type="div4">
                     <head>
                        <hi rend="italic">Original</hi>
                     </head>
                     <lg>
                        <l/>
                        <l/>
