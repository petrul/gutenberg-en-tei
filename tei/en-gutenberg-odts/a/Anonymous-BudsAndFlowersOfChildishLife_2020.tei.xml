      <body>
         <head>Buds and flowers of childish life</head>
         <author>Anonymous</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/a/Anonymous-BudsAndFlowersOfChildishLife_2020.odt</p>
