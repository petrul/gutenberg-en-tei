               <table rend="frame" xml:id="Table3">
                  <row>
                     <cell role="label">
                        <p>I. Opportunity makes the thief.<lb/>
                        </p>
                        <label>I.</label>Opportunity makes the thief.</cell>
                     <cell role="label">Dumpy ProverbsBYHonor C. Appleton<p rend="center">ILLUSTRATED<lb/>IN COLOURS<lb/>
                           <lb/>
                           <lb/>
                           <lb/>
                           <lb/>LONDON:<lb/>GRANT RICHARDS<lb/>1903</p>
                     </cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table4">
                  <row>
                     <cell role="label">Don't stop the plough to catch a mouse.</cell>
                     <cell>Don't stop the plow to catch a mouse</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table5">
                  <row>
                     <cell>Conscience makes cowards of us all</cell>
                     <cell role="label">
                        <label>II.</label>Conscience makes cowards of us all.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table6">
                  <row>
                     <cell role="label">
                        <label>III.</label>Disobedience brings its own reward.</cell>
                     <cell>Disobedience brings its own reward</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table7">
                  <row>
                     <cell>Time and tide wait for no man.</cell>
                     <cell role="label">Time and tide wait for no man.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table8">
                  <row>
                     <cell role="label">You need not cry over spilt milk.</cell>
                     <cell>You need not cry over spilt milk.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table9">
                  <row>
                     <cell>Fine feathers make fine birds.</cell>
                     <cell role="label">
                        <label>I.</label>Fine feathers make fine birds.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table10">
                  <row>
                     <cell role="label">
                        <label>II.</label>Look before you leap.</cell>
                     <cell>Look before you leap.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table11">
                  <row>
                     <cell>Those that laugh last, laugh longest.</cell>
                     <cell role="label">
                        <label>III.</label>Those that laugh last, laugh longest.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table12">
                  <row>
                     <cell role="label">Let sleeping dogs lie.</cell>
                     <cell>Let sleeping dogs lie.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table13">
                  <row>
                     <cell>A miss is as good as a mile.</cell>
                     <cell role="label">A miss is as good as a mile.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table14">
                  <row>
                     <cell role="label">
                        <label>I.</label>Pride comes before a fall.</cell>
                     <cell>Pride comes before a fall.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table15">
                  <row>
                     <cell>There's many a slip 'twixt cup and lip.</cell>
                     <cell role="label">
                        <label>II.</label>There's many a slip 'twixt cup and lip.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table16">
                  <row>
                     <cell role="label">
                        <label>III.</label>It is an ill wind that blows nobody any good.</cell>
                     <cell>It is an ill wind that blows nobody any good.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table17">
                  <row>
                     <cell>A watched pot never boils.</cell>
                     <cell role="label">A watched pot never boils.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table18">
                  <row>
                     <cell role="label">A stitch in time saves nine.</cell>
                     <cell>A stitch in time saves nine.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table19">
                  <row>
                     <cell>Barefooted men should not tread upon thorns.</cell>
                     <cell role="label">
                        <label>I.</label>Barefooted men should not tread upon thorns.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table20">
                  <row>
                     <cell role="label">
                        <label>II.</label>Experience makes a man wise.</cell>
                     <cell>Experience makes a man wise.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table21">
                  <row>
                     <cell>Misfortunes never come singly.</cell>
                     <cell role="label">Misfortunes never come singly.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table22">
                  <row>
                     <cell role="label">You cannot catch birds by throwing stones at them.</cell>
                     <cell>You cannot catch birds by throwing stones at them.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table23">
                  <row>
                     <cell>Where there's a will there's a way.</cell>
                     <cell role="label">
                        <label>I.</label>Where there's a will there's a way.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table24">
                  <row>
                     <cell role="label">
                        <label>II.</label>Appearances are deceitful.</cell>
                     <cell>Appearances are deceitful.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table25">
                  <row>
                     <cell>The longest way round is the shortest way home.</cell>
                     <cell role="label">The longest way round is the shortest way home.</cell>
                  </row>
               </table>
               <table rend="frame" xml:id="Table26">
                  <row>
                     <cell role="label">Kissing goes by favour.</cell>
                     <cell>Kissing goes by favour.</cell>
                  </row>
