         <div type="div1">
            <head>THE RAVEN</head>
            <pb/>
            <div type="div2">
               <head>By Edgar Allan Poe</head>
               <div type="div3">
                  <head>Illustrated By W. L. Taylor<lb/>
                     <lb/>Drawn and engraved under the supervision of George T. Andrew.</head>
                  <div type="div4">
                     <head>New York<lb/>
                        <lb/>E. P. Dutton And Company<lb/>
                        <lb/>39 West Twenty Third Street<lb/>
                        <lb/>1884<lb/>
                        <lb/>Copyright, 1883</head>
                     <lg>
                        <l/>
                        <l/>
                     </lg>
                     <p rend="justify">0013m <lb/>
                     </p>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <lg>
                           <l/>
                           <l/>
                        </lg>
                        <lg>
