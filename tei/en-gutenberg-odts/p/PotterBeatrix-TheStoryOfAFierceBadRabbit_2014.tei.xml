         <pb/>
         <div type="div1">
            <head>The Story of a Fierce Bad Rabbit</head>
            <p rend="justify">rabbit</p>
            <lg>
               <l>LONDON</l>
               <l>FREDERICK WARNE &amp; CO., Ltd.</l>
               <l>AND NEW YORK</l>
               <l/>
               <l>[<hi rend="italic">All rights reserved</hi>]</l>
            </lg>
            <lg>
               <l>
                  <hi rend="italic">Copyright in all countries</hi>
               </l>
               <l>
                  <hi rend="italic">signatory to the Berne Convention.</hi>
               </l>
               <l>Frederick Warne &amp; Co. Ltd.,</l>
               <l>London</l>
               <l/>
               <l/>
               <l/>
               <l/>
               <l/>
               <l>PRINTED IN GREAT BRITAIN</l>
            </lg>
            <table rend="frame" xml:id="Table1">
               <row>
                  <cell>
                     <p rend="justify">the fierce bad rabbit</p>
                  </cell>
                  <cell>
                     <p rend="justify">THIS is a fierce bad Rabbit; look at his savage whiskers, and his claws and his turned-up tail.</p>
                  </cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table2">
               <row>
                  <cell>
                     <p rend="justify">THIS is a nice gentle Rabbit. His mother has given him a carrot.</p>
                  </cell>
                  <cell rend="justify">nice bunny sitting on bench</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table3">
               <row>
                  <cell>
                     <p rend="justify">bad rabbit lstanding on bench leaning over good rabbit</p>
                  </cell>
                  <cell>
                     <p rend="justify">THE bad Rabbit would like some carrot.</p>
                  </cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table4">
               <row>
                  <cell>
                     <p rend="justify">HE doesn't say "Please." He takes it!</p>
                  </cell>
                  <cell rend="justify">bad rabbit takes carrot and pushed gentle rabbit</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table5">
               <row>
                  <cell>
                     <p rend="justify">bad rabbit scratching gentle rabbit</p>
                  </cell>
                  <cell>
                     <p rend="justify">AND he scratches the good Rabbit very badly.</p>
                  </cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table6">
               <row>
                  <cell>
                     <p rend="justify">THE good Rabbit creeps away, and hides in a hole. It feels sad.</p>
                  </cell>
                  <cell rend="justify">gentle rabbit hiding</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table7">
               <row>
                  <cell>
                     <p rend="justify">THIS is a man with a gun.</p>
                  </cell>
                  <cell rend="justify">hunter walking</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table8">
               <row>
                  <cell>
                     <p rend="justify">hunter seens bad rabbit sitting on bench</p>
                  </cell>
                  <cell>
                     <p rend="justify">HE sees something sitting on a bench. He thinks it is a very funny bird!</p>
                  </cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table9">
               <row>
                  <cell>
                     <p rend="justify">bad rabbit with runter faintly in background</p>
                  </cell>
                  <cell>
                     <p rend="justify">HE comes creeping up behind the trees.</p>
                  </cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table10">
               <row>
                  <cell>
                     <p rend="justify">AND then he shoots—Bang!</p>
                  </cell>
                  <cell rend="justify">hunter aiming</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table11">
               <row>
                  <cell>
                     <p rend="justify">a swril of ears, carrot and fluffy tail</p>
                  </cell>
                  <cell>
                     <p rend="justify">THIS is what happens—</p>
                  </cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table12">
               <row>
                  <cell>
                     <p rend="justify">BUT this is all he finds on the bench, when he rushes up with his gun.</p>
                  </cell>
                  <cell rend="justify">hunter running up to bench now with only a carrot and fluffy tail on it</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table13">
               <row>
                  <cell>
                     <p rend="justify">THE good Rabbit peeps out of its hole,</p>
                  </cell>
                  <cell rend="justify">gentle rabbit looking out of hole at hunter running off</cell>
               </row>
            </table>
            <table rend="frame" xml:id="Table14">
               <row>
                  <cell>
                     <p rend="justify">fierce bad rabbit running off without tail</p>
                  </cell>
                  <cell>
                     <p rend="justify">AND it sees the bad Rabbit tearing past—without any tail or whiskers!</p>
                  </cell>
               </row>
            </table>
