   <text>
      <body>
         <head>The Lu Lu Alphabet</head>
         <author>Miss Colman</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/c/ColmanMiss-TheLuLuAlphabet_2014.odt</p>
         <pb/>
         <div type="div1">
            <head>THE LULU ALPHABET</head>
            <pb/>
            <div type="div2">
               <head>By Anonymous</head>
               <div type="div3">
                  <head>NEW YORK:<lb/>
                     <lb/>HOWE &amp; FERRY<lb/>1887.</head>
                  <lg>
                     <l/>
                     <l/>
                     <l/>
                  </lg>
                  <p rend="justify">0001m <lb/>
                  </p>
                  <div type="div4">
                     <head>
                        <hi rend="italic">Original</hi>
                     </head>
                     <lg>
                        <l/>
                        <l/>
                     </lg>
                     <p rend="justify">0012m <lb/>
                     </p>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <lg>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0016m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">A a</p>
                        <p rend="justify">Stands for Alice,</p>
                        <p rend="justify">So graceful and fair.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0017m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">B b</p>
                        <p rend="justify">For her Bridal,</p>
                        <p rend="justify">And we were all there.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0020m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">C c</p>
                        <p rend="justify">For us Children,</p>
                        <p rend="justify">As gay as e'er seen.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0021m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">D d</p>
                        <p rend="justify">The fine Dance</p>
                        <p rend="justify">We had on the green.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0024m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">E e</p>
                        <p rend="justify">For Eliza,</p>
                        <p rend="justify">Who joined us at that.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0025m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">F f</p>
                        <p rend="justify">The gay Feather</p>
                        <p rend="justify">She wore in her hat.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0028m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">G g</p>
                        <p rend="justify">For the Grapes,</p>
                        <p rend="justify">Much better than wine.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0029m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">H h</p>
                        <p rend="justify">For the Harp</p>
                        <p rend="justify">Alice played on 'Lang syne.'</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0032m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">I i</p>
                        <p rend="justify">For the Image</p>
                        <p rend="justify">That stood in the hall.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0033m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">J j</p>
                        <p rend="justify">Is young James,</p>
                        <p rend="justify">Who played with us all.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0036m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">K k</p>
                        <p rend="justify">For the Kite,</p>
                        <p rend="justify">With colors so gay.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0037m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">L l</p>
                        <p rend="justify">For the Lady</p>
                        <p rend="justify">In costly array.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0040m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">M m</p>
                        <p rend="justify">For the Melon,</p>
                        <p rend="justify">Brought in by a Friend.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0041m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">N n</p>
                        <p rend="justify">The bright Nosegay</p>
                        <p rend="justify">The bridegroom did send.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0044m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">O o</p>
                        <p rend="justify">For the Oranges,</p>
                        <p rend="justify">Delicious and sweet.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0045m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">P p</p>
                        <p rend="justify">For young Patty,</p>
                        <p rend="justify">So cheerful and neat.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0048m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">Q q</p>
                        <p rend="justify">For the Quinces,</p>
                        <p rend="justify">All set in a row,</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0049m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">R r</p>
                        <p rend="justify">The large Raspberries;</p>
                        <p rend="justify">O! what a show!</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0052m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">S s</p>
                        <p rend="justify">For the Slipper,</p>
                        <p rend="justify">One held in her hand.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0053m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">T t</p>
                        <p rend="justify">The great Trumpet,</p>
                        <p rend="justify">That sounded so grand.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0056m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">U u</p>
                        <p rend="justify">For my Uncle,</p>
                        <p rend="justify">Who blew the loud blast.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0057m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">V v</p>
                        <p rend="justify">The grand villa,</p>
                        <p rend="justify">In which this all passed.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0060m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">W w</p>
                        <p rend="justify">The Watch,</p>
                        <p rend="justify">That dear Alice wore.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0061m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">X x</p>
                        <p rend="justify">For king Xerxes,</p>
                        <p rend="justify">Who now lives no more.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0064m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">Y y</p>
                        <p rend="justify">For our Yeoman,</p>
                        <p rend="justify">And with him did come,</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0065m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <p rend="justify">Z z</p>
                        <p rend="justify">The good Zebra</p>
                        <p rend="justify">To bring us all home.</p>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                        <p rend="justify">0076m <lb/>
                        </p>
                     </div>
                     <div type="div5">
                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </body>
   </text>
