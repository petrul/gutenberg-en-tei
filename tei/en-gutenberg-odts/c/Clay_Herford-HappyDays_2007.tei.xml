         <div type="div1">
            <head>Happy Days</head>
            <pb/>
            <div type="div2">
               <head>
                  <hi rend="italic">To Stern Critics</hi>
               </head>
               <lg>
                  <l>Here’s to stern Critics!</l>
                  <l>May they some day learn</l>
                  <l>The forward lookout’s</l>
                  <l>Better than the stern!</l>
               </lg>
               <p rend="justify">image</p>
               <lg>
                  <l>Here’s to her shadow!</l>
                  <l>May it mark the hours</l>
                  <l>Upon the sundial of her life—</l>
                  <l>in flowers!</l>
               </lg>
               <p rend="justify">page border</p>
            </div>
         </div>
