                        <head>
                           <hi rend="italic">Original</hi>
                        </head>
                        <lg>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                           <l/>
                        </lg>
                     </div>
                  </div>
               </div>
            </div>
         </div>
