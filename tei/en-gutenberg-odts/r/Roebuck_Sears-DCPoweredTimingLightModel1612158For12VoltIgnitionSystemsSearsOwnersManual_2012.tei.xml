         <head>D.C. Powered Timing Light Model 161.2158 for 12 Volt Ignition Systems / Sears Owners Manual</head>
         <author>Roebuck and Company Sears</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/r/Roebuck_Sears-DCPoweredTimingLightModel1612158For12VoltIgnitionSystemsSearsOwnersManual_2012.odt</p>
         <pb/>
         <div type="div1">
            <head>D.C. Powered Timing Light Model 161.2158 for 12 Volt Ignition Systems / Sears Owners Manual</head>
            <lg>
               <l>Sears Logo</l>
               <l/>
               <l/>
            </lg>
