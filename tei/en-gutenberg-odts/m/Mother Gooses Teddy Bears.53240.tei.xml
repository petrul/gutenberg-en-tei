         <head>Mother Goose’s Teddy Bears</head>
         <pb/>
         <div type="div1">
            <head>Mother Goose's Teddy Bears</head>
            <p rend="justify">Title page</p>
            <p rend="justify">Mother Goose’s<lb/>Teddy Bears</p>
            <lg>
               <l>Illustrated</l>
               <l>AND ADAPTED TO MOTHER GOOSE BY</l>
               <l>Frederick L. Cavally.</l>
               <l/>
               <l/>
               <l/>
               <l>THE BOBBS-MERRILL COMPANY</l>
               <l>PUBLISHERS INDIANAPOLIS U.S.A.</l>
               <l>MCMVII</l>
            </lg>
            <lg>
