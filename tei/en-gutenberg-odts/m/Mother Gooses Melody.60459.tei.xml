      <body>
         <head>Mother Goose's Melody</head>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/m/Mother Gooses Melody.60459.odt</p>
         <p>Transcriber's Note</p>
