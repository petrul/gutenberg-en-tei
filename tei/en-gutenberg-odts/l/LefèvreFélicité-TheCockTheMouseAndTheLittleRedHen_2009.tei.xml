         <head>THE COCK, THE MOUSE<lb/>AND THE LITTLE RED HEN</head>
         <pb/>
         <div type="div1">
            <head>The cock, the mouse, and the little red hen</head>
            <p rend="justify">rooster, mouse, hen</p>
            <p rend="justify"> <lb/>title page</p>
            <lg>
               <l>
                  <hi rend="smallcaps">To My Nieces</hi>
               </l>
               <l>CECILIA GARRY and NELLY MELVILLE</l>
               <l>
                  <hi rend="smallcaps">and</hi>
               </l>
               <l>
                  <hi rend="smallcaps">to my little friend</hi>
               </l>
               <l>
                  <hi rend="smallcaps">HARFORD LURY</hi>
               </l>
               <l>
                  <hi rend="smallcaps">this book is dedicated</hi>
               </l>
               <l>
                  <hi rend="smallcaps">with my love</hi>
               </l>
            </lg>
            <p rend="justify"> <lb/> </p>
            <pb/>
            <div type="div2">
               <head>
