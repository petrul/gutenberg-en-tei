         <head>The Circus Procession</head>
         <author>Unknown</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">en-gutenberg-odts/u/Unknown-TheCircusProcession_2004.odt</p>
