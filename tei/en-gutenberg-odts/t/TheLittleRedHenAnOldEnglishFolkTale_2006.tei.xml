         <head>THE LITTLE RED HEN</head>
         <p>An Old English Folk Tale</p>
         <p>Retold and Illustrated</p>
         <subtitle>by</subtitle>
         <pb/>
         <div type="div1">
            <head>The Little Red Hen / An Old English Folk Tale</head>
            <pb/>
            <div type="div2">
               <head>FLORENCE WHITE WILLIAMS</head>
               <p rend="justify"> </p>
               <p rend="justify"> </p>
               <lg>
                  <l>The</l>
                  <l>Saalfield Publishing Company</l>
                  <l>Chicago - Akron, Ohio - New York</l>
               </lg>
