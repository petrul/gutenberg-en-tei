         <div type="div1">
            <head>Death and Burial of Poor Cock Robin</head>
            <pb/>
            <div type="div2">
               <head>From Original Designs by</head>
            </div>
         </div>
         <pb/>
         <div type="div1">
            <head>H. L. STEPHENS</head>
            <pb/>
            <div type="div2">
               <head>NEW-YORK.</head>
               <div type="div3">
                  <head>Published by Hurd &amp; Houghton.</head>
                  <div type="div4">
